# Copy to .env.local and fill in. Never commit real values.

# --- Postgres (Neon) -------------------------------------------------------
DATABASE_URL=
DATABASE_URL_POOLED=

# --- Managed Better Auth ---------------------------------------------------
NEON_AUTH_BASE_URL=

# --- OTP delivery ----------------------------------------------------------
# console  prints the code to the server log (default, no provider needed)
# email    needs RESEND_API_KEY
# termii   needs TERMII_SENDER_ID, which requires CAC registration in Nigeria
OTP_CHANNEL=console

# Shows the generated code on the verification screen. Development only —
# ignored entirely when NODE_ENV=production.
OTP_DEV_MODE=1

# --- email channel ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="AfriDetect Mat <no-reply@afridetect.app>"

# --- termii (kept for when the sender ID is approved) ----------------------
TERMII_API_KEY=
TERMII_SENDER_ID=
